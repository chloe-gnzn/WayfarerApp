@page "/book"
@rendermode InteractiveServer

<PageTitle>Book a trip | Wayfarer</PageTitle>

<section class="container-page pt-6">
    <header class="mb-8 max-w-3xl">
        <h1 class="text-5xl sm:text-7xl">Hold your seats</h1>
        <p class="mt-4 max-w-xl text-lg text-ink-soft">Tell us who is going and when. Seats are reserved the moment you confirm.</p>
    </header>

    @if (confirmed is not null)
    {
        <div class="max-w-2xl overflow-hidden rounded-[2.5rem] bg-white" role="status">
            <div class="h-44 sm:h-56" aria-hidden="true"><Swatch Destination="confirmed.Item.Destination" /></div>
            <div class="p-6 sm:p-9">
                <span class="badge badge-moss">Confirmed</span>
                <h2 class="mt-3 text-4xl">You're booked, @confirmed.TravelerName.Split(' ')[0].</h2>
                <p class="mt-3 text-ink-soft">
                    Reference <strong class="text-ink">@confirmed.Reference</strong>. A confirmation will be sent to @confirmed.Email.
                </p>
                <dl class="mt-6 grid gap-x-6 gap-y-4 rounded-3xl bg-fog p-5 sm:grid-cols-2">
                    <div><dt class="text-sm text-ink-soft">Trip</dt><dd class="font-semibold">@confirmed.Item.Name</dd></div>
                    <div><dt class="text-sm text-ink-soft">Departure</dt><dd class="font-semibold">@Fmt.Date(confirmed.TravelDate)</dd></div>
                    <div><dt class="text-sm text-ink-soft">Travelers</dt><dd class="font-semibold">@confirmed.Travelers</dd></div>
                    <div><dt class="text-sm text-ink-soft">Total</dt><dd class="font-display text-3xl font-extrabold tracking-tight">@Fmt.Money(confirmed.Total)</dd></div>
                </dl>
                <div class="mt-6 flex flex-wrap gap-3">
                    <a href="/trips" class="btn btn-primary">View my trips</a>
                    <button type="button" class="btn btn-ghost" @onclick="BookAnother">Book another</button>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="grid gap-6 lg:grid-cols-12">
            <EditForm Model="form" OnValidSubmit="Submit" class="grid gap-5 rounded-[2rem] bg-white p-5 sm:p-8 lg:col-span-7" novalidate>
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="rounded-2xl bg-rose-soft p-4 text-sm font-semibold text-rose" role="alert">@error</div>
                }

                <div>
                    <label for="trip" class="label">Trip</label>
                    <InputSelect id="trip" class="input" @bind-Value="form.ItemId">
                        <option value="0">Select a trip...</option>
                        @foreach (var item in SampleData.Items)
                        {
                            <option value="@item.Id" disabled="@item.IsSoldOut">
                                @item.Name (@item.Destination.Name)@(item.IsSoldOut ? " - sold out" : "")
                            </option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => form.ItemId" />
                </div>

                <div class="grid gap-5 sm:grid-cols-2">
                    <div>
                        <label for="name" class="label">Lead traveler</label>
                        <InputText id="name" class="input" @bind-Value="form.FullName" autocomplete="name" />
                        <ValidationMessage For="() => form.FullName" />
                    </div>
                    <div>
                        <label for="email" class="label">Email</label>
                        <InputText id="email" type="email" class="input" @bind-Value="form.Email" autocomplete="email" />
                        <ValidationMessage For="() => form.Email" />
                    </div>
                </div>

                <div class="grid gap-5 sm:grid-cols-2">
                    <div>
                        <label for="travelers" class="label">Travelers</label>
                        <InputNumber id="travelers" class="input" @bind-Value="form.Travelers" min="1" max="12"
                                     ParsingErrorMessage="Enter a whole number between 1 and 12." />
                        <ValidationMessage For="() => form.Travelers" />
                    </div>
                    <div>
                        <label for="date" class="label">Departure date</label>
                        <InputDate id="date" TValue="DateTime?" class="input" @bind-Value="form.TravelDate"
                                   min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                                   ParsingErrorMessage="Enter a valid date." />
                        <ValidationMessage For="() => form.TravelDate" />
                    </div>
                </div>

                <div>
                    <label for="notes" class="label">Notes <span class="font-normal text-ink-soft">(optional)</span></label>
                    <InputTextArea id="notes" class="input" rows="3" @bind-Value="form.Notes" />
                    <p class="hint">Dietary needs, accessibility, celebrations. Up to 300 characters.</p>
                    <ValidationMessage For="() => form.Notes" />
                </div>

                <div>
                    <label class="flex min-h-11 cursor-pointer items-start gap-3">
                        <InputCheckbox class="mt-0.5 size-6 shrink-0 accent-iris" @bind-Value="form.AcceptTerms" />
                        <span class="text-sm">I understand seats are held on confirmation and can be cancelled from My trips.</span>
                    </label>
                    <ValidationMessage For="() => form.AcceptTerms" />
                </div>

                <div class="flex flex-wrap items-center gap-3 pt-2">
                    <button type="submit" class="btn btn-primary" disabled="@submitting">
                        @if (submitting)
                        {
                            <span class="spinner" aria-hidden="true"></span>
                            <span>Reserving...</span>
                        }
                        else
                        {
                            <span>Confirm booking</span>
                        }
                    </button>
                    <a href="/explore" class="btn btn-ghost">Back to trips</a>
                </div>
            </EditForm>

            <aside class="lg:col-span-5" aria-labelledby="sum-title">
                <div class="overflow-hidden rounded-[2rem] bg-white lg:sticky lg:top-6">
                    @if (SelectedItem is null)
                    {
                        <div class="h-32 bg-iris/15" aria-hidden="true"></div>
                    }
                    else
                    {
                        <div class="h-36" aria-hidden="true"><Swatch Destination="SelectedItem.Destination" /></div>
                    }
                    <div class="p-5 sm:p-6">
                        <h2 id="sum-title" class="mb-3 text-3xl">Your reservation</h2>
                        @if (SelectedItem is null)
                        {
                            <p class="text-ink-soft">Choose a trip to see its price and availability.</p>
                        }
                        else
                        {
                            <p class="font-display text-xl font-bold">@SelectedItem.Name</p>
                            <p class="text-sm text-ink-soft">@SelectedItem.Destination.Display, @SelectedItem.DurationLabel</p>
                            <dl class="mt-4 space-y-2 border-t border-ink/15 pt-4 text-sm">
                                <div class="flex justify-between"><dt>Seats left</dt><dd class="font-semibold">@SelectedItem.SeatsLeft</dd></div>
                                <div class="flex justify-between"><dt>Per traveler</dt><dd class="font-semibold">@Fmt.Money(SelectedItem.BasePrice)</dd></div>
                                <div class="flex justify-between"><dt>Travelers</dt><dd class="font-semibold">@form.Travelers</dd></div>
                                @if (SelectedItem is TourPackage && form.Travelers >= TourPackage.GroupThreshold)
                                {
                                    <div class="flex justify-between text-moss"><dt>Group discount</dt><dd class="font-semibold">@TourPackage.GroupDiscount.ToString("P0") off</dd></div>
                                }
                                <div class="flex items-end justify-between border-t border-ink/15 pt-3">
                                    <dt class="font-semibold">Total</dt>
                                    <dd class="font-display text-4xl font-extrabold tracking-tight">@Fmt.Money(SelectedItem.CalculatePrice(Math.Clamp(form.Travelers, 1, 12)))</dd>
                                </div>
                            </dl>
                            @if (form.Travelers > SelectedItem.SeatsLeft)
                            {
                                <p class="validation-message" role="alert">Only @SelectedItem.SeatsLeft seat(s) left. Reduce your group size.</p>
                            }
                        }
                    </div>
                </div>
            </aside>
        </div>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "item")]
    public int? ItemId { get; set; }

    private BookingForm form = new();
    private Booking? confirmed;
    private string? error;
    private bool submitting;

    private TravelItem? SelectedItem => SampleData.FindItem(form.ItemId);

    protected override void OnInitialized()
    {
        if (ItemId is int id && SampleData.FindItem(id) is { IsSoldOut: false })
            form.ItemId = id;
    }

    private async Task Submit()
    {
        submitting = true;
        error = null;
        await Task.Delay(900); // brief processing state

        var booking = SampleData.TryBook(form, out var message);
        submitting = false;

        if (booking is null)
        {
            error = message;
            return;
        }

        confirmed = booking;
        form = new BookingForm();
    }

    private void BookAnother()
    {
        confirmed = null;
        error = null;
    }
}
