@page "/"

<PageTitle>Wayfarer | Small-group travel, slow routes</PageTitle>

@{
    var departing = SampleData.Items
        .Where(i => !i.IsSoldOut)
        .OrderBy(i => i.SeatsLeft)
        .Take(3)
        .ToList();
    var seatsLeft = SampleData.Items.Sum(i => i.SeatsLeft);
    string[] spans =
    {
        "sm:col-span-4", "sm:col-span-2",
        "sm:col-span-2", "sm:col-span-4",
        "sm:col-span-3", "sm:col-span-3"
    };
}

<section class="container-page grid gap-12 pb-6 pt-6 lg:grid-cols-12 lg:gap-10 lg:pt-12">
    <div class="lg:col-span-7">
        <h1 class="text-[3.6rem] sm:text-8xl lg:text-[6.75rem]">
            Go slower.<br />See the place.
        </h1>
        <p class="mt-7 max-w-lg text-xl leading-relaxed text-ink-soft">
            Six guided routes and a handful of local outings, capped at sixteen travelers each, so you spend the trip
            in the place instead of in the queue.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
            <a href="/explore" class="btn btn-primary">Browse trips</a>
            <a href="/book" class="btn btn-secondary">Plan a booking</a>
        </div>

        <dl class="mt-12 flex flex-wrap gap-x-10 gap-y-4" aria-label="At a glance">
            <div class="flex flex-col-reverse">
                <dt class="text-sm text-ink-soft">Destinations</dt>
                <dd class="font-display text-5xl font-extrabold tracking-tight">@SampleData.Destinations.Count</dd>
            </div>
            <div class="flex flex-col-reverse">
                <dt class="text-sm text-ink-soft">Trips and outings</dt>
                <dd class="font-display text-5xl font-extrabold tracking-tight">@SampleData.Items.Count</dd>
            </div>
            <div class="flex flex-col-reverse">
                <dt class="text-sm text-ink-soft">Seats left</dt>
                <dd class="font-display text-5xl font-extrabold tracking-tight">@seatsLeft</dd>
            </div>
        </dl>
    </div>

    <aside class="lg:col-span-5" aria-labelledby="soon-title">
        <h2 id="soon-title" class="mb-4 text-2xl">Departing soon</h2>
        <ul class="grid gap-3">
            @foreach (var (item, n) in departing.Select((item, n) => (item, n)))
            {
                <li class="arrive" style="--i:@n">
                    <a href="/book?item=@item.Id"
                       class="tile grid grid-cols-[6.5rem_1fr] rounded-[2rem] sm:grid-cols-[8.5rem_1fr]"
                       style="--tint:@item.Destination.Accent;--deep:@item.Destination.Deep">
                        <Swatch Destination="item.Destination" />
                        <span class="flex flex-col items-start gap-1 p-4 sm:p-5">
                            <span class="font-display text-xl font-bold leading-tight tracking-tight">@item.Name</span>
                            <span class="text-sm">@item.Destination.Display, @item.DurationLabel</span>
                            <span class="mt-2 flex flex-wrap items-center gap-3">
                                <span class="tile-chip">@item.SeatsLeft @(item.SeatsLeft == 1 ? "seat" : "seats") left</span>
                                <span class="font-semibold underline decoration-2 underline-offset-4">Reserve</span>
                            </span>
                        </span>
                    </a>
                </li>
            }
        </ul>
    </aside>
</section>

<section class="container-page mt-16" aria-labelledby="index-title">
    <h2 id="index-title" class="mb-6 text-4xl sm:text-6xl">Where we go</h2>

    <ul class="grid gap-3 sm:grid-cols-6">
        @foreach (var (d, i) in SampleData.Destinations.Select((d, i) => (d, i)))
        {
            var count = SampleData.Items.Count(x => x.Destination.Id == d.Id);
            <li class="@spans[i % spans.Length]">
                <a href="/explore?q=@d.Name"
                   class="tile h-full rounded-[2rem] @(i % 4 < 2 ? "sm:rounded-tr-[5rem]" : "sm:rounded-bl-[5rem]")"
                   style="--tint:@d.Accent;--deep:@d.Deep">
                    <span class="block h-44 sm:h-52"><Swatch Destination="d" /></span>
                    <span class="flex flex-1 flex-col gap-1 p-5 sm:p-6">
                        <span class="font-display text-3xl font-bold tracking-tight">@d.Name</span>
                        <span class="text-sm font-semibold">@d.Country, @d.Region</span>
                        <span class="mt-2">@d.Tagline</span>
                        <span class="mt-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
                            <span class="tile-chip">Best in @d.BestSeason</span>
                            <span class="font-semibold underline decoration-2 underline-offset-4">See @count @(count == 1 ? "trip" : "trips")</span>
                        </span>
                    </span>
                </a>
            </li>
        }
    </ul>
</section>

<section class="container-page mt-16" aria-labelledby="how-title">
    <div class="rounded-[2.5rem] bg-iris p-7 text-white sm:p-12">
        <h2 id="how-title" class="mb-10 text-4xl sm:text-5xl">How a booking works</h2>
        <ol class="grid gap-8 md:grid-cols-3 md:gap-10">
            <li class="flex gap-4">
                <span class="grid size-11 shrink-0 place-items-center rounded-full bg-sun font-display text-xl font-bold text-ink" aria-hidden="true">1</span>
                <div>
                    <h3 class="text-2xl">Pick a route</h3>
                    <p class="mt-2 text-white/90">Filter by region, kind and price on the Explore page and open any trip for the full plan.</p>
                </div>
            </li>
            <li class="flex gap-4">
                <span class="grid size-11 shrink-0 place-items-center rounded-full bg-sun font-display text-xl font-bold text-ink" aria-hidden="true">2</span>
                <div>
                    <h3 class="text-2xl">Reserve seats</h3>
                    <p class="mt-2 text-white/90">Tell us who is traveling and when. Seats are held the moment you confirm.</p>
                </div>
            </li>
            <li class="flex gap-4">
                <span class="grid size-11 shrink-0 place-items-center rounded-full bg-sun font-display text-xl font-bold text-ink" aria-hidden="true">3</span>
                <div>
                    <h3 class="text-2xl">Manage it</h3>
                    <p class="mt-2 text-white/90">Review, total up or cancel any reservation from My trips.</p>
                </div>
            </li>
        </ol>
    </div>
</section>
